# ============================================
# LovenZea Production Environment Variables
# ============================================

# Docker Hub
DOCKERHUB_USERNAME=worknai009

# Database Configuration
DB_PASSWORD=your_secure_db_password
DB_USERNAME=root

# MinIO Object Storage Credentials
MINIO_ACCESS_KEY=minio_admin_user
MINIO_SECRET_KEY=minio_admin_password_123
MINIO_BUCKET_NAME=lovenzea-photos

# Application Security
JWT_SECRET=your_jwt_secret_key_must_be_at_least_256_bits_long
CHAT_ENCRYPTION_KEY=your_chat_encryption_key

# Mail Configuration
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME=LovenZea

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMS Configuration
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=your_sms_username
SMS_PASSWORD=your_sms_password
SMS_SENDER_ID=your_sms_sender_id
SMS_TEMPLATE_ID=your_sms_template_id

# Frontend URL
FRONTEND_URL=https://lovenzea.com