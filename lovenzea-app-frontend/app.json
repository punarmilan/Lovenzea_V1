{
  "expo": {
    "name": "LovenZea",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/project_logo.jpeg",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b051f",
        "foregroundImage": "./assets/images/project_logo.jpeg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lovenzea.online"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/project_logo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/project_logo.jpeg",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0b051f"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48acf50c-e124-4396-9794-1847402e3f2e"
      }
    }
  }
}
